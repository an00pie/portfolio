  "narrative": {
    "northStar": "The Floating Collection",
    "overview": "Projects read as objects in an explorable room, with the interface receding around them. Almost-white paper, light serif typography, compact monospaced controls, square imagery, and a handwritten Anoop signature carry the reference-matched world into quieter reading pages.\n\nThe system pairs spatial play with editorial restraint: depth belongs to the floating image field; project descriptions, biography, and case studies use centered reading columns and thin rules. Black navigation, image inspection, and contact surfaces provide concentrated contrast. The confirmed video reference and finished implementation supply the direction; this is a code-led record, not a concept proposal.",
    "keyCharacteristics": [
      "Almost-white paper and near-black ink with restrained red interaction accents.",
      "Light Spectral headings, utilitarian Arial prose, and compact Fragment Mono controls.",
      "Square image planes, narrow reading columns, and fine dividers.",
      "Inertial perspective exploration, expanding black navigation, and curtain page changes.",
      "Anoop's signature and verified asset provenance instead of borrowed identity."
    ],
    "rules": [
      { "name": "The Quiet Accent Rule", "body": "Red marks interaction and emphasis; the paper canvas and project artwork retain visual priority.", "section": "colors" },
      { "name": "The Three Voices Rule", "body": "Use Spectral for editorial hierarchy, Arial for prose, and Fragment Mono for controls and metadata; reserve handwriting for the Anoop signature.", "section": "typography" },
      { "name": "The Spatial Exception Rule", "body": "Keep reading surfaces flat; use perspective and soft shadows for the floating room's image objects.", "section": "elevation" }
    ],
    "dos": [
      "Do preserve paper-and-ink editorial surfaces and use red for interaction emphasis.",
      "Do pair serif hierarchy with Arial prose and Fragment Mono controls.",
      "Do retain square imagery, narrow reading columns, and fine ruled lists.",
      "Do preserve keyboard focus, pressed/expanded state, pause controls, and reduced-motion behavior.",
      "Do describe interface concepts and visual studies honestly, following ASSETS.md for provenance."
    ],
    "donts": [
      "Don't restore the previous neon palette or dark-theme utility overrides as the active site theme.",
      "Don't spread floating-room shadows onto editorial cards and reading panels.",
      "Don't use the signature face as a general heading or body font.",
      "Don't present illustrative project concepts as verified production screenshots or the illustrated avatar as personal photography."
    ]
  }
}
